<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Results | QuizMaster</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ taglib prefix="c" uri="jakarta.tags.core" %><header class="top"><a class="brand" href="${pageContext.request.contextPath}/">QuizMaster</a><span><c:out value="${sessionScope.user.fullName}"/> · <c:out value="${sessionScope.user.role}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="ghost">Logout</button></form></header><main class="container"><a href="${pageContext.request.contextPath}/admin/quizzes">← Quizzes</a><h1>Student results</h1><table><tr><th>Student</th><th>Quiz</th><th>Score</th><th>Status</th><th>Date</th></tr><c:forEach var="x" items="${results}"><tr><td><c:out value="${x.student}"/></td><td><c:out value="${x.quiz}"/></td><td>${x.score} / ${x.maxScore}</td><td>${x.status}</td><td>${x.date}</td></tr></c:forEach></table></main></body></html>
