<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Question management | QuizMaster</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ taglib prefix="c" uri="jakarta.tags.core" %><header class="top"><a class="brand" href="${pageContext.request.contextPath}/">QuizMaster</a><span><c:out value="${sessionScope.user.fullName}"/> · <c:out value="${sessionScope.user.role}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="ghost">Logout</button></form></header><main class="container"><a href="${pageContext.request.contextPath}/admin/quizzes">← Quizzes</a><h1>Questions: <c:out value="${quiz.title}"/></h1><section class="card"><h2>Add MCQ</h2><form method="post" action="${pageContext.request.contextPath}/admin/questions" class="stack"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="quiz" value="${quiz.id}"><label>Question<input name="text" maxlength="2000" required></label><div class="grid"><label>A<input name="a" maxlength="500" required></label><label>B<input name="b" maxlength="500" required></label><label>C<input name="c" maxlength="500" required></label><label>D<input name="d" maxlength="500" required></label></div><label>Correct option<select name="correct"><option>A</option><option>B</option><option>C</option><option>D</option></select></label><label>Marks<input type="number" name="marks" min="1" max="1000" value="1" required></label><button>Add question</button></form></section><c:forEach var="q" items="${questions}"><section class="card"><form method="post" action="${pageContext.request.contextPath}/admin/questions" class="stack"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="quiz" value="${quiz.id}"><input type="hidden" name="id" value="${q.id}"><label>Question<input name="text" value="<c:out value='${q.text}'/>" required></label><div class="grid"><label>A<input name="a" value="<c:out value='${q.a}'/>" required></label><label>B<input name="b" value="<c:out value='${q.b}'/>" required></label><label>C<input name="c" value="<c:out value='${q.c}'/>" required></label><label>D<input name="d" value="<c:out value='${q.d}'/>" required></label></div><label>Correct<select name="correct"><option value="A" ${q.correct eq 'A' ? 'selected' : ''}>A</option><option value="B" ${q.correct eq 'B' ? 'selected' : ''}>B</option><option value="C" ${q.correct eq 'C' ? 'selected' : ''}>C</option><option value="D" ${q.correct eq 'D' ? 'selected' : ''}>D</option></select></label><label>Marks<input name="marks" type="number" min="1" value="${q.marks}" required></label><div class="actions"><button>Save</button><button name="op" value="delete" class="danger" onclick="return confirm('Delete question?')">Delete</button></div></form></section></c:forEach></main></body></html>
