<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quiz management | QuizMaster</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ taglib prefix="c" uri="jakarta.tags.core" %><header class="top"><a class="brand" href="${pageContext.request.contextPath}/">QuizMaster</a><span><c:out value="${sessionScope.user.fullName}"/> · <c:out value="${sessionScope.user.role}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="ghost">Logout</button></form></header><main class="container"><div class="headline"><div><h1>Quiz management</h1><p>Create, edit, and inspect quizzes.</p></div><a href="${pageContext.request.contextPath}/admin/quizzes">Refresh</a></div><section class="card"><h2>Create a quiz</h2><form method="post" action="${pageContext.request.contextPath}/admin/quizzes" class="grid"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Title<input name="title" maxlength="200" required></label><label>Duration (min)<input type="number" name="duration" min="1" max="240" required></label><label>Total marks<input type="number" name="marks" min="1" max="10000" required></label><button>Add quiz</button></form></section><h2>Existing quizzes</h2><c:forEach var="q" items="${quizzes}"><section class="card"><form method="post" action="${pageContext.request.contextPath}/admin/quizzes" class="grid"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${q.id}"><label>Title<input name="title" value="<c:out value='${q.title}'/>" required></label><label>Minutes<input type="number" name="duration" value="${q.duration}" min="1" max="240"></label><label>Marks<input type="number" name="marks" value="${q.totalMarks}" min="1"></label><button>Save changes</button><button name="op" value="delete" class="danger" onclick="return confirm('Delete quiz?')">Delete</button></form><div class="actions"><a href="${pageContext.request.contextPath}/admin/questions?quiz=${q.id}">Manage questions</a><a href="${pageContext.request.contextPath}/admin/results?quiz=${q.id}">View results</a><a href="${pageContext.request.contextPath}/admin/export?quiz=${q.id}">Export CSV</a></div></section></c:forEach></main></body></html>
