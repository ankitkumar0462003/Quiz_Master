<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your result | QuizMaster</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ taglib prefix="c" uri="jakarta.tags.core" %><header class="top"><a class="brand" href="${pageContext.request.contextPath}/">QuizMaster</a><span><c:out value="${sessionScope.user.fullName}"/> · <c:out value="${sessionScope.user.role}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="ghost">Logout</button></form></header><main class="container"><a href="${pageContext.request.contextPath}/student/dashboard">← Dashboard</a><h1>Result: <c:out value="${quiz.title}"/></h1><div class="card"><h2>Score: ${attempt.score} / ${quiz.totalMarks}</h2><p>Percentage: <fmt:formatNumber value="${attempt.score * 100 / quiz.totalMarks}" maxFractionDigits="1"/>%</p><p>Status: <c:out value="${attempt.status}"/></p><c:if test="${attempt.status eq 'EXPIRED'}"><p>This attempt expired after the server-side deadline. Late responses were not accepted.</p></c:if></div><h2>Answer review</h2><c:forEach var="d" items="${details}"><div class="card"><p><c:out value="${d.text}"/></p><p>Your answer: <c:out value="${empty d.selected ? 'Unanswered' : d.selected}"/> · Correct: <c:out value="${d.correct}"/></p><strong>${d.right ? 'Correct' : 'Wrong / unanswered'}</strong></div></c:forEach></main></body></html>
