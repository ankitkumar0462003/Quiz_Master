<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student dashboard | QuizMaster</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ taglib prefix="c" uri="jakarta.tags.core" %><header class="top"><a class="brand" href="${pageContext.request.contextPath}/">QuizMaster</a><span><c:out value="${sessionScope.user.fullName}"/> · <c:out value="${sessionScope.user.role}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="ghost">Logout</button></form></header><main class="container"><h1>Available quizzes</h1><p>Each quiz can be attempted only once.</p><div class="cards"><c:forEach var="q" items="${quizzes}"><div class="card"><h2><c:out value="${q.title}"/></h2><p>${q.duration} minutes · ${q.totalMarks} marks</p><form method="post" action="${pageContext.request.contextPath}/student/start"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="quiz" value="${q.id}"><button>Start quiz</button></form></div></c:forEach></div><p><a href="${pageContext.request.contextPath}/student/history">View attempt history →</a></p></main></body></html>
