<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Take quiz | QuizMaster</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ taglib prefix="c" uri="jakarta.tags.core" %><header class="top"><a class="brand" href="${pageContext.request.contextPath}/">QuizMaster</a><span><c:out value="${sessionScope.user.fullName}"/> · <c:out value="${sessionScope.user.role}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="ghost">Logout</button></form></header><main class="container"><h1><c:out value="${quiz.title}"/></h1><p>Time remaining: <strong id="timer">Loading...</strong></p><p>Your answers will be submitted automatically when the countdown reaches zero. The server validates the deadline independently.</p><form id="exam" method="post" action="${pageContext.request.contextPath}/student/submit"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${attempt.id}"><c:forEach var="q" items="${questions}" varStatus="s"><section class="card"><h2>Q${s.count}. <c:out value="${q.text}"/></h2><label><input type="radio" name="q_${q.id}" value="A"> <c:out value="${q.a}"/></label><label><input type="radio" name="q_${q.id}" value="B"> <c:out value="${q.b}"/></label><label><input type="radio" name="q_${q.id}" value="C"> <c:out value="${q.c}"/></label><label><input type="radio" name="q_${q.id}" value="D"> <c:out value="${q.d}"/></label></section></c:forEach><button id="submitBtn">Submit answers</button></form><script>window.examDeadline=${deadline};</script><script src="${pageContext.request.contextPath}/js/timer.js"></script></main></body></html>
