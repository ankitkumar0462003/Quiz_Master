<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Attempt history | QuizMaster</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ taglib prefix="c" uri="jakarta.tags.core" %><header class="top"><a class="brand" href="${pageContext.request.contextPath}/">QuizMaster</a><span><c:out value="${sessionScope.user.fullName}"/> · <c:out value="${sessionScope.user.role}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="ghost">Logout</button></form></header><main class="container"><a href="${pageContext.request.contextPath}/student/dashboard">← Dashboard</a><h1>My attempt history</h1><table><tr><th>Quiz</th><th>Score</th><th>Status</th><th>Result</th></tr><c:forEach var="x" items="${history}"><tr><td><c:out value="${x.quiz}"/></td><td>${x.score} / ${x.maxScore}</td><td>${x.status}</td><td><c:choose><c:when test="${x.status eq 'IN_PROGRESS'}"><a href="${pageContext.request.contextPath}/student/attempt?id=${x.attemptId}">Continue</a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/student/result?id=${x.attemptId}">View</a></c:otherwise></c:choose></td></tr></c:forEach></table></main></body></html>
